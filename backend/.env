# ─────────────────────────────────────────────────────────
#  Mock Interview AI — Backend Environment Variables
# ─────────────────────────────────────────────────────────

PORT=5000

# ── Gemini AI (Required) ──────────────────────────────────
# Get your key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── Text-to-Speech (Optional) ────────────────────────────
# If set, AI responses will be spoken aloud in the room.
# Leave blank to use the browser's built-in Web Speech API.

# Google Cloud TTS (premium voice quality)
# GOOGLE_TTS_API_KEY=

# ElevenLabs (ultra-realistic voices)
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
